+    @add_parser
+    def fast_multipart_sansio(scenario: Scenario):
+        read = scenario.payload.read
+        chunksize = scenario.chunksize
+        with fast_multipart.PushMultipartParser(scenario.boundary) as parser:
+            parse = parser.parse
+            while not parser.closed:
+                for event in parse(read(chunksize)):
+                    pass
+
+    @add_parser
+    def fast_multipart_blocking(scenario: Scenario):
