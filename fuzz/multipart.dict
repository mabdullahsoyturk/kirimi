# libFuzzer dictionary for the parse and headers targets.
# Use with: cargo fuzz run parse -- -dict=multipart.dict

crlf="\x0d\x0a"
cr="\x0d"
lf="\x0a"
dashes="--"
boundary_short="b"
boundary="boundary"
boundary_webkit="----WebKitFormBoundary7MA4YWxkTrZu0gW"
delimiter_short="\x0d\x0a--b"
delimiter="\x0d\x0a--boundary"
first_boundary="--boundary\x0d\x0a"
close_boundary="--boundary--"
end_of_headers="\x0d\x0a\x0d\x0a"
disposition="Content-Disposition: form-data; name=\"a\""
disposition_name="name="
disposition_filename="; filename=\"f.txt\""
filename_star="filename*=UTF-8''%e2%82%ac"
content_type="Content-Type: text/plain; charset=utf8"
content_length="Content-Length: 3"
folded="\x0d\x0a "
quote="\""
escaped_quote="\\\""
percent_quote="%22"
percent_cr="%0D"
percent_lf="%0A"
windows_path="C:\\x\\"
semicolon=";"
equals="="
latin1="\xe4"
utf8="\xc3\xa4"
