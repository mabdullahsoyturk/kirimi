from collections.abc import Iterator
from typing import IO, Protocol, TypedDict, overload
from wsgiref.headers import Headers

from _typeshed import FileDescriptorOrPath

__version__: str

class MultipartError(ValueError):
    http_status: int

class ParserError(MultipartError): ...
class StrictParserError(ParserError): ...
class ParserLimitReached(MultipartError): ...
class ParserStateError(MultipartError): ...

_Limit = int | float | None

class _Readable(Protocol):
    def read(self, size: int, /) -> bytes | bytearray: ...

class _Writable(Protocol):
    def write(self, data: bytes | bytearray, /) -> object: ...

class _ParserOptions(TypedDict, total=False):
    """Keyword arguments of `MultipartParser` that `parse_form_data` passes on."""

    buffer_size: int
    header_limit: _Limit
    headersize_limit: _Limit
    part_limit: _Limit
    partsize_limit: _Limit
    spool_limit: _Limit
    memory_limit: _Limit
    disk_limit: _Limit
    mem_limit: _Limit
    memfile_limit: _Limit

class MultipartSegment:
    @property
    def headerlist(self) -> list[tuple[str, str]]: ...
    @property
    def disposition(self) -> str | None: ...
    @property
    def name(self) -> str | None: ...
    @property
    def filename(self) -> str | None: ...
    @property
    def content_type(self) -> str | None: ...
    @property
    def charset(self) -> str | None: ...
    @property
    def bytes_received(self) -> int: ...
    @property
    def complete(self) -> bool: ...
    @property
    def size(self) -> int: ...
    @overload
    def header(self, name: str) -> str | None: ...
    @overload
    def header[T](self, name: str, default: T) -> str | T: ...
    def __getitem__(self, name: str) -> str: ...

class PushMultipartParser:
    def __init__(
        self,
        boundary: str | bytes | bytearray,
        content_length: int = -1,
        max_header_size: _Limit = 4224,
        max_header_count: _Limit = 8,
        max_segment_size: _Limit = None,
        max_segment_count: _Limit = None,
        header_charset: str = "utf8",
        strict: bool = False,
    ) -> None: ...
    def parse(self, chunk: bytes | bytearray) -> list[MultipartSegment | bytes | None]: ...
    def close(self, check_complete: bool = True) -> None: ...
    def __enter__(self) -> PushMultipartParser: ...
    def __exit__(self, exc_type: object, exc_value: object, traceback: object) -> bool: ...
    @property
    def closed(self) -> bool: ...
    @property
    def error(self) -> MultipartError | None: ...
    @property
    def boundary(self) -> bytes: ...
    @property
    def content_length(self) -> int: ...
    @property
    def header_charset(self) -> str: ...
    @property
    def strict(self) -> bool: ...
    @property
    def max_header_size(self) -> int | float: ...
    @property
    def max_header_count(self) -> int | float: ...
    @property
    def max_segment_size(self) -> int | float: ...
    @property
    def max_segment_count(self) -> int | float: ...

def header_unquote(val: str, filename: bool = False) -> str: ...
def content_disposition_unquote(val: str, filename: bool = False) -> str: ...
def parse_content_disposition(value: str) -> tuple[str, str | None, str | None]: ...
def _parse_options_header(header: str, mode: int) -> tuple[str, list[tuple[str, str]] | None]: ...

class MultipartPart:
    name: str
    filename: str | None
    charset: str
    size: int
    memfile_limit: int
    buffer_size: int
    file: IO[bytes] | None
    headerlist: list[tuple[str, str]]
    def __init__(
        self,
        segment: MultipartSegment,
        buffer_size: int = 65536,
        memfile_limit: _Limit = 262144,
        charset: str = "utf8",
    ) -> None: ...
    @property
    def headers(self) -> Headers: ...
    @property
    def disposition(self) -> str | None: ...
    @property
    def content_type(self) -> str: ...
    @property
    def raw(self) -> bytes: ...
    @property
    def value(self) -> str: ...
    def is_buffered(self) -> bool: ...
    def save_as(self, path: FileDescriptorOrPath) -> int: ...
    def close(self) -> None: ...
    # Private methods kept for compatibility with `multipart`.
    def _write(self, chunk: bytes | bytearray) -> None: ...
    def _mark_complete(self) -> None: ...

class MultipartParser:
    stream: _Readable
    boundary: str | bytes
    content_length: int
    charset: str
    strict: bool
    buffer_size: int
    header_limit: int | float
    headersize_limit: int | float
    part_limit: int | float
    partsize_limit: int | float
    spool_limit: int | float
    memory_limit: int | float
    disk_limit: int | float
    def __init__(
        self,
        stream: _Readable,
        boundary: str | bytes,
        content_length: int = -1,
        charset: str = "utf8",
        strict: bool = False,
        buffer_size: int = 65536,
        header_limit: _Limit = 8,
        headersize_limit: _Limit = 4224,
        part_limit: _Limit = 128,
        partsize_limit: _Limit = None,
        spool_limit: _Limit = 65536,
        memory_limit: _Limit = 8388608,
        disk_limit: _Limit = None,
        mem_limit: _Limit = 0,
        memfile_limit: _Limit = 0,
    ) -> None: ...
    def __iter__(self) -> Iterator[MultipartPart]: ...
    def parts(self) -> list[MultipartPart]: ...
    @overload
    def get(self, name: str) -> MultipartPart | None: ...
    @overload
    def get[T](self, name: str, default: T) -> MultipartPart | T: ...
    def get_all(self, name: str) -> list[MultipartPart]: ...
