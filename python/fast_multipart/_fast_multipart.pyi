from typing import Any, Iterator, Optional, Union

class MultipartError(ValueError):
    http_status: int

class ParserError(MultipartError): ...
class StrictParserError(ParserError): ...
class ParserLimitReached(MultipartError): ...
class ParserStateError(MultipartError): ...

_Limit = Union[int, float, None]

class MultipartSegment:
    @property
    def headerlist(self) -> list[tuple[str, str]]: ...
    @property
    def disposition(self) -> Optional[str]: ...
    @property
    def name(self) -> Optional[str]: ...
    @property
    def filename(self) -> Optional[str]: ...
    @property
    def content_type(self) -> Optional[str]: ...
    @property
    def charset(self) -> Optional[str]: ...
    @property
    def bytes_received(self) -> int: ...
    @property
    def complete(self) -> bool: ...
    @property
    def size(self) -> int: ...
    def header(self, name: str, default: object = None) -> object: ...
    def __getitem__(self, name: str) -> str: ...

class PushMultipartParser:
    def __init__(
        self,
        boundary: Union[str, bytes, bytearray],
        content_length: int = -1,
        max_header_size: _Limit = 4224,
        max_header_count: _Limit = 8,
        max_segment_size: _Limit = None,
        max_segment_count: _Limit = None,
        header_charset: str = "utf8",
        strict: bool = False,
    ) -> None: ...
    def parse(
        self, chunk: Union[bytes, bytearray]
    ) -> list[Union[MultipartSegment, bytes, None]]: ...
    def close(self, check_complete: bool = True) -> None: ...
    def __enter__(self) -> "PushMultipartParser": ...
    def __exit__(self, exc_type: object, exc_value: object, traceback: object) -> bool: ...
    @property
    def closed(self) -> bool: ...
    @property
    def error(self) -> Optional[MultipartError]: ...
    @property
    def boundary(self) -> bytes: ...
    @property
    def content_length(self) -> int: ...
    @property
    def header_charset(self) -> str: ...
    @property
    def strict(self) -> bool: ...
    @property
    def max_header_size(self) -> Union[int, float]: ...
    @property
    def max_header_count(self) -> Union[int, float]: ...
    @property
    def max_segment_size(self) -> Union[int, float]: ...
    @property
    def max_segment_count(self) -> Union[int, float]: ...

def header_unquote(val: str, filename: bool = False) -> str: ...
def content_disposition_unquote(val: str, filename: bool = False) -> str: ...
def parse_content_disposition(value: str) -> tuple[str, Optional[str], Optional[str]]: ...
def _parse_options_header(
    header: str, mode: int
) -> tuple[str, Optional[list[tuple[str, str]]]]: ...

class MultipartPart:
    name: str
    filename: Optional[str]
    charset: str
    size: int
    memfile_limit: int
    buffer_size: int
    file: Any
    headerlist: list[tuple[str, str]]
    def __init__(
        self,
        segment: MultipartSegment,
        buffer_size: int = 65536,
        memfile_limit: _Limit = 262144,
        charset: str = "utf8",
    ) -> None: ...
    @property
    def headers(self) -> Any: ...
    @property
    def disposition(self) -> Optional[str]: ...
    @property
    def content_type(self) -> str: ...
    @property
    def raw(self) -> bytes: ...
    @property
    def value(self) -> str: ...
    def is_buffered(self) -> bool: ...
    def save_as(self, path: Any) -> int: ...
    def close(self) -> None: ...

class MultipartParser:
    stream: Any
    boundary: Union[str, bytes]
    content_length: int
    charset: str
    strict: bool
    buffer_size: int
    header_limit: Union[int, float]
    headersize_limit: Union[int, float]
    part_limit: Union[int, float]
    partsize_limit: Union[int, float]
    spool_limit: Union[int, float]
    memory_limit: Union[int, float]
    disk_limit: Union[int, float]
    def __init__(
        self,
        stream: Any,
        boundary: Union[str, bytes],
        content_length: int = -1,
        charset: str = "utf8",
        strict: bool = False,
        buffer_size: int = 65536,
        header_limit: _Limit = 8,
        headersize_limit: _Limit = 4224,
        part_limit: _Limit = 128,
        partsize_limit: _Limit = None,
        spool_limit: _Limit = 65536,
        memory_limit: _Limit = 8388608,
        disk_limit: _Limit = None,
        mem_limit: _Limit = 0,
        memfile_limit: _Limit = 0,
    ) -> None: ...
    def __iter__(self) -> Iterator[MultipartPart]: ...
    def parts(self) -> list[MultipartPart]: ...
    def get(self, name: str, default: Any = None) -> Any: ...
    def get_all(self, name: str) -> list[MultipartPart]: ...
